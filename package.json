{
  "name": "aathena",
  "version": "0.3.4",
  "description": "Type-safe AWS Athena client for TypeScript",
  "author": "bug3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bug3/aathena.git"
  },
  "bugs": {
    "url": "https://github.com/bug3/aathena/issues"
  },
  "homepage": "https://github.com/bug3/aathena#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aathena": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./runtime": {
      "import": "./dist/runtime/index.js",
      "require": "./dist/runtime/index.cjs"
    }
  },
  "files": [
    "dist",
    "llms.txt",
    "llms-full.txt"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "typecheck:examples": "for d in examples/*/; do [ -f \"$d/tsconfig.json\" ] || { echo \"missing tsconfig: $d\" >&2; exit 1; }; echo \"typecheck $d\"; tsc -p \"$d/tsconfig.json\" --noEmit || exit 1; done",
    "typecheck:docs": "tsc -p docs/snippets/tsconfig.json --noEmit",
    "examples:regen": "UPDATE_EXAMPLES=1 vitest run tests/examples-generated.test.ts",
    "check:snippets": "node scripts/check-doc-snippets.mjs",
    "check:placeholders": "node scripts/check-docs-placeholders.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "smoke:pack": "bash scripts/smoke-pack.sh",
    "prepublishOnly": "npm run lint && npm test && npm run typecheck:examples && npm run check:snippets && npm run build && npm run smoke:pack"
  },
  "keywords": [
    "athena",
    "aws-athena",
    "aws",
    "typescript",
    "type-safe",
    "codegen",
    "sql"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-athena": "^3.1032.0",
    "@aws-sdk/client-glue": "^3.1032.0",
    "@clack/prompts": "^1.2.0",
    "sql-render": "^0.3.4"
  },
  "optionalDependencies": {
    "@aws-sdk/client-service-quotas": "^3.1032.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.4",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.1",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4"
  }
}
